{
  "name": "coding-profile-tracker",
  "version": "0.4.0",
  "description": "Track your LeetCode, Codeforces, HackerRank, CodeChef and GeeksforGeeks progress from one place.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:charts": "vite-node scripts/preview-charts.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
