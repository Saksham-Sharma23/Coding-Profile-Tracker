{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "types": ["chrome", "node", "vite/client", "vitest/globals"],

    // No baseUrl: since TS 4.4 `paths` entries resolve relative to this file, and
    // baseUrl's other job — resolving bare specifiers against a root directory — is
    // legacy behaviour nothing here uses. Vite resolves the same alias itself in
    // vite.config.ts, so this mapping only informs the type checker.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "manifest.config.ts"]
}
